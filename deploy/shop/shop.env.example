# backend/.env for the SHOP PC (single process: ERP UI + API on one port, SQL Server only).
# install-shop.ps1 copies this to backend/.env and fills the secrets and SHOP_TENANT_ID for you.
# You only need to set the SQL passwords below.

PORT=5000
NODE_ENV=production
APP_DATA_MODE=sql-only

# Serve the built frontend from this same server (one port for screens + API).
SERVE_FRONTEND_DIR=../frontend/dist
# The shop network is plain http. Without this, browsers drop the login cookie.
ALLOW_PLAIN_HTTP=true
COOKIE_SAME_SITE=lax

JWT_SECRET=__GENERATED__
JWT_REFRESH_SECRET=__GENERATED__
COOKIE_SECRET=__GENERATED__
SHOP_TENANT_ID=__GENERATED__
EMAIL_ENABLED=false

# --- Textilesoft SQL Server (same PC as the ERP: localhost) ---
TEXTILESOFT_DB_HOST=localhost
TEXTILESOFT_DB_PORT=1433
# TEXTILESOFT_DB_INSTANCE=SQLEXPRESS
TEXTILESOFT_DB_NAME=SSS_copy
TEXTILESOFT_DB_ENCRYPT=false
TEXTILESOFT_DB_TRUST_CERT=true
TEXTILESOFT_DB_USER=erp_readonly
TEXTILESOFT_DB_PASSWORD=change-me
ITEM_DATA_SOURCE=sql
AUTH_SOURCE=sql

# --- ERP POS bills -> dbo.sales2 + dbo.salsntry ---
# Keep off until you want to test ERP billing. While TEXTILESOFT_DB_NAME is SSS_copy, bills are erased at the next restore.
TEXTILESOFT_POS_WRITE=off
TEXTILESOFT_DB_WRITE_USER=erp_pos_writer
TEXTILESOFT_DB_WRITE_PASSWORD=change-me
TEXTILESOFT_POS_COMPANY=
TEXTILESOFT_POS_USERID=ERP

# Admin login used only to restore SSS_copy and re-apply the ERP logins' grants after a restore.
TEXTILESOFT_ADMIN_USER=sa
TEXTILESOFT_ADMIN_PASSWORD=change-me

# Textilesoft rights value that becomes the ERP owner role.
TEXTILESOFT_OWNER_RIGHTS=admin
TEXTILESOFT_OWNER_USERS=
SHOP_NAME=
