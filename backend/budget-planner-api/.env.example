# Server
PORT=4000
NODE_ENV=development
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget_planner
DB_USER=postgres
DB_PASSWORD=your_password

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=budget_planner_jwt_secret_change_in_prod
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=budget_planner_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# PIN (for app lock feature)
PIN_HASH_ROUNDS=10

# CORS - allow personal MFE app
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Currency default
DEFAULT_CURRENCY=INR
