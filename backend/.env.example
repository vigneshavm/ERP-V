PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/bizzai
JWT_SECRET=bizzai_jwt_secret_key_example_123
JWT_REFRESH_SECRET=bizzai_refresh_token_secret_example_456
# Token lifetimes — keep access tokens SHORT (15m) so the device-lock model works
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Redis — required for distributed rate limiting and token blocklist
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
COOKIE_SECRET=bizzai_signed_cookie_secret_example_789
COOKIE_SAME_SITE=lax
EMAIL_ENABLED=false
# EMAIL_USER=example@gmail.com
# EMAIL_PASS=your_app_password
GEMINI_API_KEY=your_gemini_api_key_here
