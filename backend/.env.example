PORT=5000
NODE_ENV=development
# The API uses SQL only. Routes without a reviewed existing SQL mapping return 503.
APP_DATA_MODE=sql-only
JWT_SECRET=your_super_secure_jwt_secret_key_change_me
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_me
COOKIE_SECRET=your_super_secure_cookie_secret_change_me
COOKIE_SAME_SITE=lax
EMAIL_ENABLED=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# Textilesoft shop database (SQL Server 'SSS').
# Use a dedicated SQL login with db_datareader on SSS only. Never reuse the sa/web.config login.
TEXTILESOFT_DB_HOST=localhost
TEXTILESOFT_DB_PORT=1433
# TEXTILESOFT_DB_INSTANCE=SQLEXPRESS
TEXTILESOFT_DB_NAME=SSS_copy
TEXTILESOFT_DB_USER=erp_readonly
TEXTILESOFT_DB_PASSWORD=change-me
TEXTILESOFT_DB_ENCRYPT=false
TEXTILESOFT_DB_TRUST_CERT=true

# --- Item & stock read source -------------------------------------------------------------
# SQL item catalogue and stock source. The reviewed mapping file is required.
ITEM_DATA_SOURCE=sql
# TEXTILESOFT_MAPPING_FILE=textilesoft.mapping.json
# TEXTILESOFT_LOW_STOCK_DEFAULT=5

# --- ERP POS bills -> Textilesoft (dbo.sales2 + dbo.salsntry) ---------------------------------
# OFF unless set to on. While on, POS bills are written to the shop database named in TEXTILESOFT_DB_NAME,
# numbered on the chosen Textilesoft counter.
TEXTILESOFT_POS_WRITE=off
# GST slab selection: exGst preserves current behavior; legacy selects from per-unit inclusive price after discounts.
TEXTILESOFT_SLAB_BASIS=exGst
# A login that may INSERT into dbo.sales2 and dbo.salsntry (the normal TEXTILESOFT_DB_USER is read-only).
TEXTILESOFT_DB_WRITE_USER=erp_pos_writer
TEXTILESOFT_DB_WRITE_PASSWORD=change-me
# Company (bill_option.cmny_name) whose bill series ERP bills use; empty = the counter's first company.
TEXTILESOFT_POS_COMPANY=
# Login name recorded on ERP bills (UserID column), so they can be told apart from Textilesoft's.
TEXTILESOFT_POS_USERID=ERP

# Admin SQL login (e.g. sa or another sysadmin). Used to restore SSS_copy and, right after every restore,
# to re-create the ERP logins' database users and grants (the restore wipes them). Also used to repair
# access automatically when the ERP finds its login locked out (e.g. after a restore done in SSMS).
TEXTILESOFT_ADMIN_USER=sa
TEXTILESOFT_ADMIN_PASSWORD=change-me

# --- Login -------------------------------------------------------------------------------------
# Users log in with their Textilesoft user ID + password (dbo.newuser in TEXTILESOFT_DB_NAME).
AUTH_SOURCE=sql
# Configured single-shop tenant key used by API request context.
SHOP_TENANT_ID=
# Textilesoft user IDs that get the ERP owner role (comma separated). The startup log lists who is owner/staff.
TEXTILESOFT_OWNER_USERS=
# Textilesoft "Rights" values (dbo.newuser.rights) that get the ERP owner role, comma separated. Everyone else = staff.
TEXTILESOFT_OWNER_RIGHTS=admin

# --- ERP-owned SQL database --------------------------------------------------------------------
# Separate database for ERP-owned records. Must not equal TEXTILESOFT_DB_NAME (normally SSS).
# Uses the same SQL Server host/port/TLS settings above, but a dedicated database login.
# Runtime ERP SQL access uses existing tables only; this application does not initialize or alter schema.
# ERP_SQL_DB_NAME=ERPData
# ERP_SQL_DB_USER=erp_app
# ERP_SQL_DB_PASSWORD=change-me

# Failed logins allowed per user ID / per IP in 15 minutes before 429 (defaults 10 / 30).
LOGIN_MAX_FAILS_ACCOUNT=10
LOGIN_MAX_FAILS_IP=30
# Shop name shown in the ERP header. Leave empty to use the name Textilesoft prints on its bills (Headerfooterentry.header1).
SHOP_NAME=
