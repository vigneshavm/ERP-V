VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_USE_SUPABASE=false

# Tenant Configuration

VITE_TENANT_SUBDOMAIN=
VITE_TENANT_ID=
VITE_REQUIRE_TENANT_ID=false

# Gemini API (used in geminiService.ts)
VITE_GEMINI_API_KEY=

# Encryption
# Auth Mode: 'ENCRYPTION' (AES) or 'HASH' (Bcrypt)
VITE_AUTH_MODE=HASH
VITE_APP_SECRET=your_secure_random_string_here
VITE_BCRYPT_SALT_ROUNDS=10
